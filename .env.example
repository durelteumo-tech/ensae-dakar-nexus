# Configuration Supabase (Auth + PostgreSQL + Storage)
# Créez un projet gratuit sur https://supabase.com et exécutez supabase/schema.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé Gemini utilisée côté serveur par le QCM, le Smart Reader et le Chef de Projet.
# Copiez ce fichier vers .env.local en local ; configurez cette variable dans
# l'hébergeur pour partager l'IA avec l'équipe.
# Obtenez une clé sur https://aistudio.google.com/apikey
GEMINI_API_KEY=
